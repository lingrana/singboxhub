{{define "setup"}}<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>初始化数据库</title>
<link rel="stylesheet" href="/admin/assets/style.css">
<script src="/admin/assets/setup.js" defer></script>
</head>
<body>
<main class="setup-wrap">
  <section class="setup-panel">
    <p class="eyebrow mono">澪 / FIRST RUN</p>
    <h1>初始化数据库</h1>
    <p class="setup-lead">选择面板的数据存储。SQLite 适合单机部署，PostgreSQL 适合多实例或集中式部署。</p>
    {{if .Error}}<p class="error mono">{{.Error}}</p>{{end}}
    <form method="post" action="/setup" class="setup-form">
      <fieldset>
        <legend class="mono">DATABASE ENGINE</legend>
        <label class="setup-choice"><input type="radio" name="driver" value="sqlite" checked> <span>SQLite</span><small>本地文件，零外部服务</small></label>
        <label class="setup-choice"><input type="radio" name="driver" value="postgres"> <span>PostgreSQL</span><small>填写 PostgreSQL 连接 DSN</small></label>
      </fieldset>
      <label for="dsn" class="mono">DATABASE PATH / DSN</label>
      <input id="dsn" name="dsn" value="{{.SQLiteDSN}}" required autocomplete="off">
      <p class="setup-hint mono">SQLite 示例：data/panel.db　PostgreSQL 示例：postgres://user:password@host:5432/singhub?sslmode=require</p>
      <button type="submit" class="submit-btn">初始化并启动 →</button>
    </form>
  </section>
</main>
</body>
</html>{{end}}

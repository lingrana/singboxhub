{{define "setup"}}<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>初始化数据库</title>
<link rel="stylesheet" href="/admin/assets/style.css">
<script src="/admin/assets/setup.js" defer></script>
</head>
<body>
<main class="setup-wrap">
  <section class="setup-panel">
    <p class="eyebrow mono">澪 / FIRST RUN</p>
    <h1>初始化数据库</h1>
    <p class="setup-lead">选择数据存储，并设置首次登录使用的管理员账号。</p>
    {{if .Error}}<p class="error mono">{{.Error}}</p>{{end}}
    <form method="post" action="/setup" class="setup-form">
      <fieldset>
        <legend class="mono">ADMINISTRATOR</legend>
        <label for="setup-username" class="mono">管理员用户名</label>
        <input id="setup-username" name="username" required maxlength="64" autocomplete="username">
        <label for="setup-password" class="mono">管理员密码</label>
        <input id="setup-password" name="password" type="password" required minlength="6" maxlength="72" autocomplete="new-password">
        <label for="setup-confirm-password" class="mono">确认管理员密码</label>
        <input id="setup-confirm-password" name="confirm_password" type="password" required minlength="6" maxlength="72" autocomplete="new-password">
      </fieldset>
      <fieldset>
        <legend class="mono">DATABASE ENGINE</legend>
        <label class="setup-choice"><input type="radio" name="driver" value="sqlite" checked> <span>SQLite</span><small>本地文件，零外部服务</small></label>
        <label class="setup-choice"><input type="radio" name="driver" value="postgres"> <span>PostgreSQL</span><small>填写 PostgreSQL 连接 DSN</small></label>
      </fieldset>
      <label for="dsn" class="mono">DATABASE PATH / DSN</label>
      <input id="dsn" name="dsn" value="{{.SQLiteDSN}}" required autocomplete="off">
      <p class="setup-hint mono">SQLite 示例：data/panel.db　PostgreSQL 示例：postgres://user:password@host:5432/singhub　（未指定 sslmode 时自动协商加密；需强制加密可加 sslmode=require 或 verify-full）</p>
      <button type="submit" class="submit-btn">初始化并启动 →</button>
    </form>
  </section>
</main>
</body>
</html>{{end}}
